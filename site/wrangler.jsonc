// Cloudflare Workers config for aiinsuregenie.com.
// Build: node build.js (outputs dist/). Deploy: npx wrangler deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiinsuregenie-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Same URLs as Vercel's cleanUrls + trailingSlash: /blog/ serves blog/index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Run the Worker on every request so agent visits are logged.
    "run_worker_first": true
  },
  // Same D1 database as the API. The site only writes to the agent_visits table.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiinsuregenie",
      "database_id": "23e91a15-4ae0-4cdd-82da-9524bfc165b6"
    }
  ],
  // Request logs (including agent visits) show in the dashboard under Workers Logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
