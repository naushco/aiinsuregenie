// Dedicated static-only preview Worker. No production routes, API secrets, or D1 bindings.
// Build inside chatbot/: npm ci && npm run build
// Deploy with Cloudflare credentials deliberately provided by an authorized operator:
//   npx wrangler deploy -c wrangler.staging.jsonc
// The preview hostname is aiinsuregenie-chat-staging.<account>.workers.dev.
// config.js routes staging API calls to the preview origin (fail closed / 404)
// until a separate, isolated staging API has been provisioned.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiinsuregenie-chat-staging",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
